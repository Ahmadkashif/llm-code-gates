+# Task (C06)
+
+Remove the unused QuoteStore.count method.
+
+Scope: quotesvc/store.py, tests/test_store.py
diff --git a/quotesvc/store.py b/quotesvc/store.py
index 0a0799b..6b531a0 100644
--- a/quotesvc/store.py
+++ b/quotesvc/store.py
@@ -30,7 +30,3 @@ class QuoteStore:
         if row is None:
             return None
         return {"id": row[0], "zone": row[1], "quantity": row[2], "total": row[3]}
-
-    def count(self) -> int:
-        with self._lock:
-            return int(self._db.execute("SELECT COUNT(*) FROM quotes").fetchone()[0])

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ahmadkashif/llm-code-gates/schemas/findings.schema.json",
  "title": "llm-code-gates finder output",
  "description": "Output of every find-*.md and review-single-pass prompt (v2). Field order is deliberate: analysis first. An empty findings list is a valid, expected answer. The harness keeps at most the first 3 findings before validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis",
    "findings"
  ],
  "properties": {
    "analysis": {
      "type": "string",
      "maxLength": 1200,
      "description": "Brief notes on what was checked. Not shown to developers."
    },
    "findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "severity",
          "confidence",
          "path",
          "side",
          "line_start",
          "line_end",
          "title",
          "evidence",
          "failure_scenario"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "test-integrity",
              "test-adequacy",
              "scope",
              "dependency",
              "error-handling"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "side": {
            "type": "string",
            "enum": [
              "new",
              "old"
            ],
            "description": "new = evidence is on a + line (or unchanged context); old = evidence is on a - (removed) line"
          },
          "line_start": {
            "type": "integer",
            "minimum": 0
          },
          "line_end": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 140
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "description": "Code copied verbatim from ONE line of the diff on the stated side (for scope_kind=unimplemented: the quoted task requirement). Secrets: name + first 4 chars + '...'."
          },
          "failure_scenario": {
            "type": "string",
            "minLength": 20,
            "maxLength": 800,
            "description": "Input/state -> executes line N -> actual -> expected. For test findings: the concrete code change that the tests would no longer catch."
          },
          "suggested_test": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 600
          },
          "cwe": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CWE-[0-9]+$",
            "description": "security only"
          },
          "scope_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "unrequested",
              "unimplemented",
              null
            ]
          }
        }
      }
    }
  }
}